#info
h       get-help-window
H       get-info-help-node
gg      beginning-of-node
ge      end-of-node
gf      first-node
gl      last-node
gn      global-next-node
gp      global-prev-node
gu      up-node
^g      goto-node
j       next-line
k       prev-line
f       scroll-forward-page-only
z       scroll-forward-page-only-set-window
b       scroll-backward-page-only
w       scroll-backward-page-only-set-window
d       scroll-half-screen-down
u       scroll-half-screen-up
]       next-node
[       prev-node
t       top-node
I       goto-invocation-node
n       search-next
N       search-previous
\r      select-reference-this-line
^c      abort-key
^j      down-line
^k      up-line
\mf     xref-item
^xr     xref-item
\mh     get-info-help-node
\kd     down-line
q       quit
:q      quit
ZZ      quit

#echo-area
\mh     echo-area-backward
\ml     echo-area-forward
\m0     echo-area-beg-of-line
\m$     echo-area-end-of-line
\mw     echo-area-forward-word
\mx     echo-area-delete
\mu     echo-area-abort
^v      echo-area-quoted-insert
\mX     echo-area-kill-word

#var
cursor-movement-scrolls=Off
ISO-Latin=On
nodeline=print
visible-bell=On
link-style=blue
active-link-style=underline,red
